{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Global nav/footer content shared across the site"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "logoMark": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "navLinks": {
      "type": "component",
      "component": "shared.nav-link",
      "repeatable": true
    },
    "footerBrandDesc": {
      "type": "text"
    },
    "footerExploreLinks": {
      "type": "component",
      "component": "shared.nav-link",
      "repeatable": true
    },
    "footerAboutLinks": {
      "type": "component",
      "component": "shared.nav-link",
      "repeatable": true
    },
    "footerConnectLinks": {
      "type": "component",
      "component": "shared.nav-link",
      "repeatable": true
    },
    "footerCopyrightText": {
      "type": "string"
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.nav-link",
      "repeatable": true
    }
  }
}
