{
  "kind": "collectionType",
  "collectionName": "subcategories",
  "info": {
    "singularName": "subcategory",
    "pluralName": "subcategories",
    "displayName": "Subcategory",
    "description": "Second-level taxonomy terms under each Pillar"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
